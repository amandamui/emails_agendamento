# Copie este arquivo para ".env" e preencha com os valores reais.
# O .env NÃO vai para o Git; este .env.example vai (sem segredos).

# Login do portal app.brautoparts.com.br
BRA_EMAIL=seu.usuario@empresa.com.br
BRA_SENHA=sua_senha_aqui

# E-mails (Outlook)
EMAIL_REMETENTE=seu.email@empresa.com.br
EMAIL_TESTE=seu.email@empresa.com.br
# Destinatários do balanço semanal (devolutiva.py --enviar), separados por ';'
EMAIL_DEVOLUTIVA=pessoa1@empresa.com.br;pessoa2@empresa.com.br

# Fornecedor da fase de teste (filtro "contém" na Razão Social). Padrão: Gates
FORNECEDOR_TESTE=Gates

# (Opcional) Nome da assinatura do Outlook, sem ".htm".
# Em branco = usa a assinatura mais recente de %APPDATA%\Microsoft\Signatures
ASSINATURA_OUTLOOK=

# 1 = ignora erros de certificado HTTPS (use só se o proxy da empresa exigir)
IGNORAR_CERTIFICADO=0
